{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".runtime-build",
    "rootDir": "src/core",
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/core/hub/**/*.ts", "src/core/runtime/**/*.ts"]
}
